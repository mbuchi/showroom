{
  "name": "showroom",
  "private": true,
  "version": "0.40.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint --type-aware --tsconfig tsconfig.app.json",
    "lint:syntax": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:export-fonts": "node scripts/check-export-fonts.mjs"
  },
  "dependencies": {
    "@aireon/shared": "github:mbuchi/aireon-shared#v1.209.0",
    "@openreplay/tracker": "^18.1.3",
    "@qualipool/swissrets-json": "^3.6.0",
    "@react-pdf/renderer": "^4.9.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.3.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-joyride": "^2.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^25.0.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-joyride": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-floater": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
